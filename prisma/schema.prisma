// The database connection URL lives in prisma.config.ts (read from DATABASE_URL in .env).
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Doctors are static seed data (prisma/seed.ts). No doctor login and no admin editing.
model Doctor {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  specialty String
  bookings  Booking[]
}

// A patient who registered (Task 3). The password is not stored yet: hashing comes in Task 4.
// Nothing here is unique or checked, because the server does not validate anything yet.
model Patient {
  id              Int       @id @default(autoincrement())
  name            String
  email           String
  phone           String
  termsAcceptedAt DateTime?
  createdAt       DateTime  @default(now())
}

// One booking request from the /book form. Validation rules beyond "filled in" come in Task 3.
model Booking {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  doctor    Doctor   @relation(fields: [doctorId], references: [id])
  doctorId  Int
  date      DateTime @db.Date
  time      String
  createdAt DateTime @default(now())
}
